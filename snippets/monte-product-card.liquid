{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign product_group = product.metafields.custom.product_group.value
  assign group_colors = product_group.colors.value
  assign current_color = nil
  assign color_count = 0
  for color in group_colors
    if color.product.value != blank and color.swatch.value != blank
      assign color_count = color_count | plus: 1
      if color.product.value.id == product.id
        assign current_color = color
      endif
    endif
  endfor
  assign use_group = false
  if current_color != nil
    assign use_group = true
  endif
  assign card_subtitle = product.metafields.custom.product_subtitle.value
  if use_group and product_group.subtitle.value != blank
    assign card_subtitle = product_group.subtitle.value
  endif
  assign color_option = nil
  assign color_labels = 'general.label.color' | t | append: ',color,colour,kolor,couleur,farbe' | downcase | split: ','
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    assign swatched_values = option.values | map: 'swatch' | compact
    if color_labels contains option_name or swatched_values.size > 0
      assign color_option = option
      break
    endif
  endfor
-%}
{%- capture card_title -%}
  {%- if use_group and product_group.title.value != blank -%}
    {{- product_group.title.value | escape -}}
  {%- elsif hide_color_suffix or product.has_only_default_variant -%}
    {%- render 'monte-product-display-title', product: product -%}
  {%- else -%}
    {{- product.title | escape -}}
  {%- endif -%}
{%- endcapture -%}
<article class="monte-product-card{% if mobile_hidden %} monte-product-card--mobile-hidden{% endif %}">
  <a class="monte-product-card__link" href="{{ product.url }}" aria-label="{{ card_title }}" draggable="false"></a>
  <div class="monte-product-card__media">
    {%- if product.featured_media -%}
      {{- product.featured_media | image_url: width: 1200 | image_tag: class: 'monte-product-card__image', loading: 'lazy', widths: '180,260,360,500,650,850,1200', sizes: '(min-width: 1000px) calc((100vw - 140px) / 4), (min-width: 700px) calc((100vw - 100px) / 2), calc((100vw - 48px) / 2)', alt: '', draggable: 'false' -}}
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
    {%- render 'product-badges', product: product, variant: variant, types: 'monte_status', monte_status_overridden: use_group, monte_status_override: current_color.badge.value, class: 'monte-product-card__badges' -%}
  </div>
  <div class="monte-product-card__info">
    {%- if use_group -%}
      <div class="monte-product-card__swatches" aria-label="Kolory">
        {%- render 'monte-product-color-swatch', color: current_color, selected: true -%}
        {%- assign visible_colors = 1 -%}
        {%- for color in group_colors -%}
          {%- if color.product.value != blank and color.swatch.value != blank and color.product.value.id != product.id -%}
            {%- render 'monte-product-color-swatch', color: color, selected: false -%}
            {%- assign visible_colors = visible_colors | plus: 1 -%}
            {%- if visible_colors == 3 -%}{%- break -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if color_count > visible_colors -%}
          <a class="monte-product-card__more" href="{{ product.url }}" aria-label="Zobacz pozostałe kolory: {{ color_count | minus: visible_colors }}">+{{ color_count | minus: visible_colors }}</a>
        {%- endif -%}
      </div>
    {%- elsif color_option != nil -%}
      <div class="monte-product-card__swatches" aria-label="{{ color_option.name | escape }}">
        {%- capture param_name -%}monte-{{ section.id }}-{{ tab_id }}-{{ product.id }}{%- endcapture -%}
        {%- for option_value in color_option.values limit: 3 -%}
          {%- assign option_key = 'option' | append: color_option.position -%}
          {%- assign color_variant = product.variants | where: option_key, option_value.name | first -%}
          {%- assign color_url = color_variant.url | default: product.url -%}
          {%- render 'option-value', type: 'swatch', option_value: option_value, param_name: param_name, option_position: color_option.position, url: color_url, size: 'sm' -%}
        {%- endfor -%}
        {%- if color_option.values.size > 3 -%}<a class="monte-product-card__more" href="{{ product.url }}" aria-label="{{ 'product.general.available_colors_count' | t: count: color_option.values.size }}">+{{ color_option.values.size | minus: 3 }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="monte-product-card__details">
      <div class="monte-product-card__titles">
        <h3>{{ card_title }}</h3>
        {%- if card_subtitle != blank -%}<p class="monte-product-card__subtitle">{{ card_subtitle | escape }}</p>{%- endif -%}
      </div>
      {%- render 'price-list', variant: variant, hide_unit_price: true, monte_card_discount: true -%}
    </div>
  </div>
</article>
