{%- liquid
  assign options = block.settings
  assign product_group = product.metafields.custom.product_group.value
  assign colors = product_group.colors.value
  assign picker_count = 0
  assign regular_count = 0
  assign limited_count = 0
  assign current_color = nil
  for color in colors
    if color.product.value != blank
      assign picker_count = picker_count | plus: 1
      if color.limited_color.value == true
        assign limited_count = limited_count | plus: 1
      else
        assign regular_count = regular_count | plus: 1
      endif
      if color.product.value.id == product.id
        assign current_color = color
      endif
    endif
  endfor
  assign show_pair = false
  if picker_count > 0 or template.suffix == 'poszewki' or template.suffix == 'scrunchies'
    assign show_pair = true
  endif
  assign variant = product.selected_or_first_available_variant
  assign drawer_id = 'MonteProductPicker-' | append: section.id
-%}
<monte-product-bundle class="mp-bundle" data-bundle-group="{{ product.type | handleize }}" data-drawer="{{ drawer_id }}" data-discount="{{ options.row2_discount | default: 10 }}" data-savings-label="{{ options.savings_label | default: 'Oszczędzasz' | escape }}" {{ block.shopify_attributes }}>
  <script type="application/json" data-bundle-data>{"current":{% render 'monte-bundle-product-json', item: product, color: current_color, group_title: product_group.title.value %},"products":[{%- assign separator = '' -%}{%- for color in colors -%}{%- assign item = color.product.value -%}{%- if item != blank -%}{{ separator }}{% render 'monte-bundle-product-json', item: item, color: color, group_title: product_group.title.value %}{%- assign separator = ',' -%}{%- endif -%}{%- endfor -%}],"variants":{{ product.variants | json }}}</script>
  {%- if regular_count > 0 -%}
    <div class="mp-colors">
      <p class="mp-label"><strong>Kolor:</strong> {% if current_color.limited_color.value == true %}Wybierz kolor{% else %}{% capture color_label %}{% render 'monte-product-color-label', item: product, color: current_color %}{% endcapture %}{{ color_label | escape }}{% endif %}</p>
      <div class="mp-swatches">
        {%- for color in colors -%}
          {%- if color.product.value != blank and color.limited_color.value != true -%}
            {% render 'monte-bundle-color-thumbnail', color: color, current_product: product %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  {%- if limited_count > 0 -%}
    <div class="mp-colors">
      <p class="mp-label"><strong>Kolor:</strong> {% if current_color.limited_color.value == true %}{{ current_color.color_name.value | escape }}{% else %}{{ options.limited_label | escape }}{% endif %}</p>
      <div class="mp-swatches">
        {%- for color in colors -%}
          {%- if color.product.value != blank and color.limited_color.value == true -%}
            {% render 'monte-bundle-color-thumbnail', color: color, current_product: product %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  {%- unless product.has_only_default_variant -%}<label class="mp-variant-label">{{ product.options | join: ' / ' | escape }}<select data-current-variant>{%- for item in product.variants -%}<option value="{{ item.id }}" {% if item.id == variant.id %}selected{% endif %}>{{ item.title | escape }} — {{ item.price | money }}{% unless item.available %} — Wyprzedane{% endunless %}</option>{%- endfor -%}</select></label>{%- endunless -%}
  <div class="mp-bundle-options">
    <p class="mp-label"><strong>Zestaw:</strong> <span data-selected-label>{{ options.row1_title | default: '1 Maska' | escape }}</span></p>
    <div class="mp-bundle-choice" data-choice="1" data-selected="true"><label class="mp-choice-header"><input type="radio" name="Bundle-{{ section.id }}" value="1" checked><span class="mp-choice-copy"><strong data-option-title>{{ options.row1_title | default: '1 Maska' | escape }}</strong><span class="mp-choice-savings" data-single-saving {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ options.savings_label | default: 'Oszczędzasz' | escape }} {{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros }}</span></span><span class="mp-choice-price"><strong data-single-price>{{ variant.price | money_without_trailing_zeros }}</strong><s data-single-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money_without_trailing_zeros }}</s></span></label>{%- if options.row1_footer != blank -%}<p class="mp-bundle-footer">{{ options.row1_footer | escape }}</p>{%- endif -%}</div>
    {%- if show_pair -%}
      <div class="mp-bundle-choice" data-choice="2" data-selected="false">
        <span class="mp-bundle-ribbon"><img src="{{ 'monte-bundle-ribbon-left.svg' | asset_url }}" width="12" height="12" alt=""><span>{{ options.monte_bundle_badge | default: 'KORZYSTNIEJSZY' | escape }}</span><img src="{{ 'monte-bundle-ribbon-right.svg' | asset_url }}" width="12" height="12" alt=""></span>
        <label class="mp-choice-header mp-choice-header--pair"><input type="radio" name="Bundle-{{ section.id }}" value="2"><span class="mp-choice-copy"><strong data-option-title>{{ options.row2_title | default: '2 Maski' | escape }}</strong><span class="mp-choice-savings" data-pair-saving></span></span><span class="mp-choice-price"><strong data-pair-price></strong><s data-pair-compare></s></span></label>
        <div class="mp-bundle-slots" hidden><div class="mp-bundle-slots-content">{%- for i in (0..1) -%}<div class="mp-bundle-slot" data-slot="{{ i }}"><span class="mp-slot-picture"><img alt="" width="40" height="40" hidden><span data-slot-plus>+</span></span><strong data-slot-title hidden></strong><button type="button" class="mp-small-primary" data-pick-slot="{{ i }}">{{ options.choose_color_label | default: 'Wybierz kolor maski' | escape }}</button><button type="button" class="mp-slot-remove" data-remove-slot="{{ i }}" aria-label="Usuń produkt {{ i | plus: 1 }}" hidden>{% render 'icon', icon: 'close', width: 12 %}</button></div>{%- endfor -%}</div></div>
        {%- if options.row2_footer != blank -%}<p class="mp-bundle-footer">{{ options.row2_footer | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <button type="button" class="mp-atc" data-bundle-atc {% unless variant.available %}disabled{% endunless %}><span data-atc-label>{{ 'product.general.add_to_cart_button' | t }}</span><span class="mp-basket"><img src="{{ 'monte-pdp-basket.svg' | asset_url }}" width="22.0333" height="22.3868" alt=""></span></button>
  <p class="mp-bundle-error" role="alert" hidden></p>
  <noscript><form action="{{ routes.cart_add_url }}" method="post"><input type="hidden" name="id" value="{{ variant.id }}"><button class="mp-atc" type="submit" {% unless variant.available %}disabled{% endunless %}>{{ 'product.general.add_to_cart_button' | t }}</button></form></noscript>
  <monte-product-picker id="{{ drawer_id }}" class="drawer mp-picker" aria-labelledby="{{ drawer_id }}-title" tabindex="-1">
    <div class="mp-picker-shell"><header><h2 id="{{ drawer_id }}-title">{{ options.popup_title | default: 'Wybierz produkt' | escape }}</h2><button type="button" data-picker-close aria-label="Zamknij">{% render 'icon', icon: 'close', width: 16 %}</button></header>
      <div class="mp-picker-list">{%- for color in colors -%}{%- assign item = color.product.value -%}{%- if item == blank -%}{%- continue -%}{%- endif -%}{%- assign item_variant = item.selected_or_first_available_variant -%}<div class="mp-picker-item">
        {% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 160 | image_tag: width: 64, height: 64, loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        <div><strong>{% render 'monte-product-display-title', product: item, group_title: product_group.title.value %}</strong>{%- capture item_color -%}{% render 'monte-product-color-label', item: item, color: color %}{%- endcapture -%}{%- if item_color != blank -%}<p>Kolor: {{ item_color | escape }}</p>{%- endif -%}
          {%- unless item.has_only_default_variant -%}<select data-picker-variant data-product-id="{{ item.id }}" aria-label="Wariant {{ item.title | escape }}">{%- for v in item.variants -%}<option value="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: 0 }}" data-available="{{ v.available }}" {% if v.id == item_variant.id %}selected{% endif %}>{{ v.title | escape }}{% unless v.available %} — Wyprzedane{% endunless %}</option>{%- endfor -%}</select>{%- endunless -%}
        </div><button type="button" class="mp-pick" data-pick-product="{{ item.id }}" {% unless item_variant.available %}disabled{% endunless %}><span>{{ options.popup_choose_label | default: 'Wybierz' | escape }}</span><span class="mp-pick-plus" aria-hidden="true"></span></button>
      </div>{%- endfor -%}</div>
    </div>
  </monte-product-picker>
</monte-product-bundle>
