{{ 'monte-collection-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign design_images = design_images | default: section.settings.design_images
  assign hero_heading = hero_heading | default: section.settings.heading
  assign hero_subheading = hero_subheading | default: section.settings.subheading
  assign desktop_image = section.settings.image
  assign desktop_video = section.settings.video
  assign mobile_image = section.settings.mobile_image
  assign mobile_video = section.settings.mobile_video
  if mobile_image == blank and mobile_video == blank
    assign mobile_image = desktop_image
    assign mobile_video = desktop_video
  endif
  assign rating = settings.monte_social_rating | default: 4.5 | at_least: 0 | at_most: 5
  assign rating_text = shop.metafields.custom.rating_text_social.value
-%}
<style>
  #shopify-section-{{ section.id }} { background: transparent; margin: 0; padding: 0; }
</style>
<reveal-items class="monte-collection-hero{% if design_images == 'about' %} monte-collection-hero--about{% endif %}" selector=".monte-collection-hero__content" margin="0px" style="--mch-gradient-opacity: {% if design_images == 'faq' or design_images == 'policy' or design_images == 'contact' or design_images == 'about' or design_images == 'builder' %}.7{% else %}.8{% endif %}; --mch-height-desktop: {{ section.settings.desktop_height }}px; --mch-height-mobile: {{ section.settings.mobile_height }}px; --mch-heading: {{ section.settings.heading_color }}; --mch-body: {{ section.settings.body_color }}; --mch-rating: {{ section.settings.rating_color }}; --mch-overlay: {{ section.settings.overlay_color }}; --mch-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --mch-image-position: {{ desktop_image.presentation.focal_point | default: '50% 50%' }}; --mch-mobile-image-position: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};">
  <div class="monte-collection-hero__frame{% if section.settings.mobile_gradient %} monte-collection-hero__frame--gradient{% endif %}">
    <div class="monte-collection-hero__media" aria-hidden="true">
      {%- for device in (1..2) -%}
        {%- liquid
          assign device_class = 'desktop'
          assign hero_video = desktop_video
          assign hero_image = desktop_image
          if device == 2
            assign device_class = 'mobile'
            assign hero_video = mobile_video
            assign hero_image = mobile_image
          endif
        -%}
        <div class="monte-collection-hero__{{ device_class }}">
          {%- if hero_video != blank -%}
            {%- render 'media', media: hero_video, autoplay: true, loop: true, show_play_button: true, preload: true, sizes: '100vw' -%}
          {%- elsif hero_image != blank -%}
            {{- hero_image | image_url: width: 3200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,800,1200,1600,2000,2400,3200', sizes: '100vw', alt: '' -}}
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder monte-media-placeholder' | replace: '<svg', '<svg aria-hidden="true" preserveAspectRatio="xMidYMid slice"' -}}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="monte-collection-hero__overlay" aria-hidden="true"></div>
    <div class="monte-collection-hero__content">
      {% if section.settings.badge_text != blank %}<span class="monte-collection-hero__badge" style="background:{{ section.settings.badge_background }};color:{{ section.settings.badge_color }};">{{ section.settings.badge_text | escape }}</span>{% endif %}
      {%- if section.settings.show_rating -%}
        <div class="monte-collection-hero__rating">
          {%- render 'monte-social-rating', rating: rating -%}
          {%- if rating_text != blank -%}<p>{{ rating_text | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if hero_heading != blank or hero_subheading != blank -%}
        <div class="monte-collection-hero__copy">
          {%- if hero_heading != blank -%}<h1 class="monte-collection-hero__heading">{{ hero_heading | escape | newline_to_br }}</h1>{%- endif -%}
          {%- if hero_subheading != blank -%}<p class="monte-collection-hero__subheading">{{ hero_subheading | escape | newline_to_br }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</reveal-items>

