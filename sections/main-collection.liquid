{{ 'monte-product-tabs.css' | asset_url | stylesheet_tag }}
{{ 'monte-collection-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'monte-collection-grid.js' | asset_url }}" defer></script>

{%- liquid
  assign selected_sort = collection.sort_by | default: collection.default_sort_by
  assign sort_option = collection.sort_options | where: 'value', selected_sort | first
  assign sort_label = sort_option.name
  if selected_sort == 'best-selling'
    assign sort_label = section.settings.best_selling_label
  endif
  assign sort_id = 'monte-sort-' | append: section.id
-%}
{%- paginate collection.products by 12 -%}
  <monte-collection-grid class="monte-catalog" data-section-id="{{ section.id }}" data-default-sort="{{ collection.default_sort_by }}" data-total="{{ collection.products_count }}" data-error="{{ section.settings.error_text | escape }}" style="--mp-primary: {{ section.settings.text_color }}; --mp-secondary: {{ section.settings.secondary_color }}; --mp-card: {{ section.settings.card_color }}; --mc-muted: {{ section.settings.muted_color }};">
    <div class="monte-catalog__toolbar">
      <p class="monte-catalog__count">{{ 'collection.products_count' | t: count: collection.products_count }}</p>
      <facet-sort-by class="monte-catalog__sort">
        <span id="{{ sort_id }}-label">{{ section.settings.sort_label | escape }}:</span>
        <button type="button" class="monte-catalog__sort-button" aria-labelledby="{{ sort_id }}-label {{ sort_id }}-value" aria-controls="{{ sort_id }}" aria-expanded="false">
          <span id="{{ sort_id }}-value">{{ sort_label | escape }}</span>
          <img src="{{ 'monte-header-chevron.svg' | asset_url }}" width="10" height="7" alt="">
        </button>
        <x-popover id="{{ sort_id }}" class="popover monte-sort" style="--ms-primary: {{ section.settings.text_color }}; --ms-secondary: {{ section.settings.secondary_color }}; --ms-muted: {{ section.settings.muted_color }};" close-on-listbox-select anchor-horizontal="end" anchor-vertical="end">
          <div slot="title" class="monte-sort__heading">
            <span>{{ section.settings.sort_label | escape }}:</span>
            <button type="button" is="close-button" class="monte-sort__close" aria-label="{{ 'general.accessibility.close' | t | escape }}">
              <img src="{{ 'monte-search-close.svg' | asset_url }}" width="13.5607" height="13.5607" alt="">
            </button>
            <img class="monte-sort__divider" src="{{ 'monte-nav-divider.png' | asset_url }}" width="335" height="1" alt="">
          </div>
          <x-listbox class="popover-listbox" aria-owns="{{ sort_id }}-value">
            {%- assign sort_values = 'best-selling,title-ascending,title-descending,price-ascending,price-descending' | split: ',' -%}
            {%- for sort_value in sort_values -%}
              {%- assign option = collection.sort_options | where: 'value', sort_value | first -%}
              <button type="button" class="popover-listbox__option group" role="option" value="{{ option.value }}" {% if option.value == selected_sort %}aria-selected="true"{% endif %}>
                <span class="reversed-link">{% if option.value == 'best-selling' %}{{ section.settings.best_selling_label | escape }}{% else %}{{ option.name | escape }}{% endif %}</span>
              </button>
            {%- endfor -%}
          </x-listbox>
        </x-popover>
      </facet-sort-by>
    </div>
    <div class="monte-catalog__results" aria-busy="false">
      {%- if collection.products_count == 0 -%}
        <div class="empty-state">
          <div class="empty-state__icon-wrapper">
            {%- render 'icon' with 'picto-stop', width: 32, height: 32, stroke_width: 1 -%}
            <span class="count-bubble count-bubble--lg">0</span>
          </div>
          <div class="prose">
            <p class="h4">{{ 'collection.general.empty_collection' | t }}</p>
            {%- assign continue_label = 'collection.general.continue_shopping' | t -%}
            {%- render 'button', href: routes.all_products_collection_url, content: continue_label, style: 'outline' -%}
          </div>
        </div>
      {%- else -%}
        <reveal-items class="monte-catalog__batch" selector=".monte-product-card" margin="0px">
          <div class="monte-catalog__grid">
            {%- for product in collection.products -%}
              {%- render 'monte-product-card', product: product, tab_id: 'catalog' -%}
            {%- endfor -%}
          </div>
        </reveal-items>
      {%- endif -%}
    </div>
    {%- assign shown_count = paginate.current_offset | plus: collection.products.size -%}
    <div class="monte-catalog__more" {% unless paginate.next %}hidden{% endunless %}>
      <a class="button button--outline" data-load-more href="{{ paginate.next.url }}">{{ section.settings.load_more_label | escape }}</a>
      <p class="monte-catalog__summary">{{ section.settings.count_text | replace: '[shown]', shown_count | replace: '[total]', collection.products_count }}</p>
      <div class="monte-catalog__progress" role="progressbar" aria-label="{{ section.settings.progress_label | escape }}" aria-valuemin="0" aria-valuemax="{{ collection.products_count }}" aria-valuenow="{{ shown_count }}">
        <span style="width: {% if collection.products_count > 0 %}{{ shown_count | times: 100.0 | divided_by: collection.products_count }}{% else %}0{% endif %}%"></span>
      </div>
    </div>
    <p class="monte-catalog__status sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
  </monte-collection-grid>
{%- endpaginate -%}

{% schema %}
{
  "name": "Monté Collection Grid",
  "class": "shopify-section--main-collection",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Products come from the active collection. Desktop shows four columns, mobile shows two. Each load adds 12 products. Product details use the same cards as the homepage." },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "Sortuj według" },
    { "type": "text", "id": "best_selling_label", "label": "Best-selling label", "default": "Bestsellery" },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Pokaż więcej" },
    { "type": "text", "id": "count_text", "label": "Loaded product count", "default": "Wyświetlono [shown] z [total] produktów", "info": "Use [shown] and [total] for the dynamic counts." },
    { "type": "text", "id": "progress_label", "label": "Progress accessibility label", "default": "Wyświetlone produkty" },
    { "type": "text", "id": "error_text", "label": "Loading error", "default": "Nie udało się wczytać produktów. Spróbuj ponownie." },
    { "type": "color", "id": "text_color", "label": "Primary text", "default": "#232E71" },
    { "type": "color", "id": "secondary_color", "label": "Secondary text", "default": "#52597E" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#9BA0B5" },
    { "type": "color", "id": "card_color", "label": "Card surface", "default": "#EEE7E0" }
  ]
}
{% endschema %}
