{%- capture items -%}
  {%- for i in (1..9) -%}
    {%- liquid
      assign prefix = 'item_' | append: i | append: '_'
      assign enabled_key = prefix | append: 'enabled'
      unless block.settings[enabled_key]
        continue
      endunless
      assign image_key = prefix | append: 'image'
      assign video_key = prefix | append: 'video'
      assign type_key = prefix | append: 'media_type'
      assign alt_key = prefix | append: 'alt'
      assign play_key = prefix | append: 'play_overlay'
      assign media = block.settings[image_key]
      assign video = nil
      if block.settings[type_key] == 'video'
        assign video = block.settings[video_key]
      endif
      assign label = block.settings[alt_key] | default: block.settings.title
    -%}
    {%- if media != blank or video != blank -%}
      <button type="button" class="mp-ugc-item" data-lightbox-item aria-label="{{ label | escape }} — {{ i }}">
        {%- if video != blank -%}{{ video | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '600x' }}
        {%- elsif media != blank -%}{{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '240,480,800,1200', sizes: '(min-width: 1000px) 15vw, 30vw' }}{%- endif -%}
        {%- if block.settings.show_play and block.settings[play_key] -%}<span class="mp-play"><img src="{{ 'monte-pdp-play.svg' | asset_url }}" width="24" height="24" alt=""></span>{%- endif -%}
      </button>
    {%- else -%}
      <div class="mp-ugc-item mp-ugc-item--placeholder" aria-hidden="true">{{ 'image' | placeholder_svg_tag: 'placeholder monte-media-placeholder' }}</div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if items != blank -%}
  <reveal-items margin="0px" {{ block.shopify_attributes }}><monte-product-media class="mp-ugc">
    <div class="mp-ugc-header"><h2>{{ block.settings.title | escape }}</h2><div class="mp-arrows" hidden><button type="button" data-ugc-step="-1" aria-label="Poprzednie materiały" disabled>{% render 'icon', icon: 'chevron-left', width: 16 %}</button><button type="button" data-ugc-step="1" aria-label="Następne materiały">{% render 'icon', icon: 'chevron-right', width: 16 %}</button></div></div>
    <div class="mp-ugc-track" data-media-track tabindex="0" aria-label="{{ block.settings.title | escape }}">{{ items }}</div>
    <div class="mp-ugc-progress" aria-hidden="true" hidden><span></span></div>
    {% render 'monte-ugc-stories', block: block %}
  </monte-product-media></reveal-items>
{%- elsif request.design_mode -%}<div {{ block.shopify_attributes }}>Enable a media item in this block to show the UGC carousel.</div>{%- endif -%}
