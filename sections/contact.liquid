{%- render 'monte-contact', section: section -%}

{% schema %}
{
  "name": "Monté Contact Form",
  "class": "shopify-section--contact",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shared Monté design across all pages. Each section keeps its own editable content. Messages use Shopify contact delivery; the recipient is configured in Shopify."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Nie znalazłeś odpowiedzi?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Odpowiadamy na każdą wiadomość w ciągu 24 godzin.</p>"
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "Content style",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "company",
          "label": "Company details"
        }
      ],
      "default": "standard",
      "info": "Company details use the design’s compact text layout and PP Mori Extrabold emphasis."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Imię"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "E-mail"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Twoja wiadomość..."
    },
    {
      "type": "text",
      "id": "privacy_prefix",
      "label": "Privacy text before link",
      "default": "Akceptuję"
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy link label",
      "default": "politykę prywatności"
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy policy link",
      "info": "Uses the store privacy policy when empty."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Wyślij wiadomość"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "monte_primary",
      "label": "Monté heading and input text",
      "default": "#232E71"
    },
    {
      "type": "color",
      "id": "monte_secondary",
      "label": "Monté description and privacy text",
      "default": "#52597E"
    },
    {
      "type": "color",
      "id": "monte_field",
      "label": "Monté field background",
      "default": "#EEE7E0"
    },
    {
      "type": "color",
      "id": "monte_border",
      "label": "Monté field border",
      "default": "#DCD6CF"
    },
    {
      "type": "color",
      "id": "monte_placeholder",
      "label": "Monté placeholder text",
      "default": "#9BA0B5"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#232E71"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FDFBF9"
    }
  ],
  "presets": [
    {
      "name": "Monté Contact Form",
      "category": "Call to action"
    }
  ]
}
{% endschema %}
