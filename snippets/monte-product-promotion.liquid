{%- capture campaign_handle -%}{%- render 'monte-campaign-slot', slot: 'product_promo' -%}{%- endcapture -%}
{%- assign campaign_content = metaobjects.monte_campaign_placement[campaign_handle] -%}
{%- liquid
  assign promo_title = campaign_content.heading.value | default: block.settings.monte_promo_title
  assign promo_text = campaign_content.body.value | default: block.settings.monte_promo_text
  assign promo_icon = campaign_content.icon.value | default: block.settings.monte_promo_icon
  assign promo_bg = campaign_content.background.value | default: block.settings.monte_promo_bg
  assign promo_color = campaign_content.text_color.value | default: block.settings.monte_promo_color
-%}
{%- unless campaign_handle == '__hidden__' -%}
{%- if block.settings.monte_promo_enabled != false or campaign_content != blank -%}
<reveal-items class="mp-promotion" margin="0px" {{ block.shopify_attributes }}>
  <div class="mp-promo" style="--promo-bg:{{ promo_bg }};--promo-color:{{ promo_color }}">
    <span class="mp-promo-icon">
      {%- if promo_icon != blank -%}
        {{ promo_icon | image_url: width: 80 | image_tag: width: 20, height: 20, loading: 'lazy', alt: '' }}
      {%- else -%}<img src="{{ 'monte-pdp-discount.svg' | asset_url }}" width="18.6875" height="18.6875" alt="">{%- endif -%}
    </span>
    <div>
      {%- if promo_title != blank -%}<strong>{{ promo_title | escape }}</strong>{%- endif -%}
      {%- if promo_text != blank -%}<p {% if campaign_content.text_color.value != blank %}style="color:inherit"{% endif %}>{{ promo_text | escape | newline_to_br }}</p>{%- endif -%}
    </div>
    <img class="mp-promo-mark" src="{{ 'monte-pdp-promo-logo.svg' | asset_url }}" width="99" height="99" alt="">
  </div>
</reveal-items>
{%- endif -%}

{%- endunless -%}
