{%- liquid
  assign description = product.metafields.custom.zalety_description
  assign specification = product.metafields.custom.specyfikacja
  assign benefit_count = 0
  for i in (1..10)
    assign key = 'benefit_' | append: i
    if block.settings[key] != blank
      assign benefit_count = benefit_count | plus: 1
    endif
  endfor
-%}
{%- if description != blank or benefit_count > 0 or specification != blank -%}
  <reveal-items class="mp-tabs-reveal" margin="0px" {{ block.shopify_attributes }}>
    <monte-pdp-tabs class="mp-tabs">
      <template><style>:host{display:block}.titles{display:flex;gap:16px;border-bottom:1px solid #DCD6CF}slot[name=title]{display:contents}::slotted([slot=title]){flex:1}::slotted([hidden]){display:none!important}</style><div class="titles" role="tablist"><slot name="title"></slot></div><slot name="content"></slot></template>
      {%- if description != blank or benefit_count > 0 -%}
        <button type="button" slot="title">{{ block.settings.benefits_label | escape }}</button>
        <div slot="content" class="mp-tab-panel">
          {%- if description != blank -%}
            <div>
              <div class="mp-description mp-description--collapsed prose" id="PdpDescription-{{ section.id }}-{{ block.id }}" data-description>{%- if description.type == 'rich_text_field' -%}{{ description | metafield_tag }}{%- else -%}{{ description.value | escape | newline_to_br }}{%- endif -%}</div>
              <button type="button" class="mp-expand" data-expand data-expand-label="{{ block.settings.expand_label | escape }}" data-collapse-label="{{ block.settings.collapse_label | escape }}" aria-expanded="false" aria-controls="PdpDescription-{{ section.id }}-{{ block.id }}" hidden><span>{{ block.settings.expand_label | escape }}</span>{% render 'icon', icon: 'chevron-bottom', width: 10 %}</button>
            </div>
          {%- endif -%}
          {%- if benefit_count > 0 -%}<ul class="mp-benefits mp-benefits--tab">{%- for i in (1..10) -%}{%- assign key = 'benefit_' | append: i -%}{%- if block.settings[key] != blank -%}<li>{% render 'monte-product-check' %}<span>{{ block.settings[key] | escape }}</span></li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if specification != blank -%}<button type="button" slot="title">{{ block.settings.specification_label | escape }}</button><div slot="content" class="mp-tab-panel mp-specification prose">{%- if specification.type == 'rich_text_field' -%}{{ specification | metafield_tag }}{%- else -%}{{ specification.value | escape | newline_to_br }}{%- endif -%}</div>{%- endif -%}
    </monte-pdp-tabs>
  </reveal-items>
{%- endif -%}
