{%- liquid
  assign hero_heading = block.settings.hero_heading | default: block.settings.title
  assign rating_text = shop.metafields.custom.rating_text_social.value
  assign rating = settings.monte_social_rating | default: 4.5 | at_least: 0 | at_most: 5
-%}
{%- liquid
  assign hero_subheading = campaign_content.body.value | default: block.settings.subheading
  assign hero_mobile_subheading = campaign_content.mobile_body.value | default: block.settings.hero_mobile_subheading
  assign hero_button_text = campaign_content.button_label.value | default: block.settings.button_text
  assign hero_button_link = campaign_content.link.value | default: block.settings.button_link
-%}
{%- assign hero_heading = campaign_content.heading.value | default: hero_heading -%}
{%- if campaign_content.body.value != blank and campaign_content.mobile_body.value == blank -%}{%- assign hero_mobile_subheading = '' -%}{%- endif -%}
<div class="monte-hero__content" style="--hero-button-hover: {{ block.settings.hero_button_hover | default: '#eee7e0' }};">
  {%- if block.settings.hero_show_rating -%}
    <div class="monte-hero__rating" data-sequence="subheading">
      {%- render 'monte-social-rating', rating: rating -%}
      {%- if rating_text != blank -%}<p>{{ rating_text | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="monte-hero__messaging">
    {%- if hero_heading != blank -%}
      {%- if first_slide and request.page_type == 'index' -%}
        <h1 class="monte-hero__heading" data-sequence="heading">{{ hero_heading | escape | newline_to_br }}</h1>
      {%- else -%}
        <h2 class="monte-hero__heading" data-sequence="heading">{{ hero_heading | escape | newline_to_br }}</h2>
      {%- endif -%}
    {%- endif -%}
    {%- if hero_subheading != blank -%}
      <p class="monte-hero__subheading {% if hero_mobile_subheading != blank %}monte-hero__subheading--desktop{% endif %}" data-sequence="subheading">{{ hero_subheading | escape }}</p>
    {%- endif -%}
    {%- if hero_mobile_subheading != blank -%}
      <p class="monte-hero__subheading monte-hero__subheading--mobile" data-sequence="subheading">{{ hero_mobile_subheading | escape | newline_to_br }}</p>
    {%- endif -%}
  </div>
  {%- if hero_button_text != blank -%}
    {%- render 'button', href: hero_button_link, content: hero_button_text, background: block.settings.button_background, text_color: hero_button_text_color, style: 'fill' -%}
  {%- endif -%}
</div>
