{%- comment -%}Decorative layers stay below the hero content and never intercept input.{%- endcomment -%}
<monte-hero-frost class="monte-hero__frost" aria-hidden="true" data-monte-reveal="off">
  <div class="monte-hero__frost-shade"></div>
  <img class="monte-hero__frost-layer monte-hero__frost-layer--snow" src="{{ 'monte-frost-snow.webp' | asset_url }}" width="1600" height="799" alt="" loading="eager" decoding="async">
  <img class="monte-hero__frost-layer monte-hero__frost-layer--scattered" src="{{ 'monte-frost-scattered.webp' | asset_url }}" width="1600" height="1066" alt="" loading="eager" decoding="async">
  <img class="monte-hero__frost-layer monte-hero__frost-layer--frame" src="{{ 'monte-frost-frame.webp' | asset_url }}" width="1600" height="1509" alt="" loading="eager" decoding="async">
  <img class="monte-hero__frost-layer monte-hero__frost-layer--frame monte-hero__frost-layer--bottom" src="{{ 'monte-frost-frame.webp' | asset_url }}" width="1600" height="1509" alt="" loading="eager" decoding="async">
</monte-hero-frost>
<noscript><style>.monte-hero__frost { display: none !important; }</style></noscript>
<script src="{{ 'monte-hero-frost.js' | asset_url }}" defer></script>
