    "monte_product_details": {
      "type": "monte-product-details",
      "blocks": {
        "detail_1": {
          "type": "item",
          "settings": {
            "title": "100% blackout dla całkowitej ciemności",
            "description": "<p>Tak. Monté ma rozszerzone pokrycie obejmujące oczy i górną część twarzy, eliminując światło z każdej strony. 94% klientów w ankiecie po zakupie oceniło blackout jako całkowity.</p>"
          }
        },
        "detail_2": {
          "type": "item",
          "settings": {
            "title": "Nie wchłania kosmetyków, zero załamów rano",
            "description": "<p>Dobra rutyna zaczyna się od tego, co dotyka twojej skóry przez całą noc. Jedwab morwowy 22 momme jest gładki i spokojny dla twarzy, więc budzisz się wypoczęta, bez załamów i śladów na skórze.</p>"
          }
        },
        "detail_3": {
          "type": "item",
          "settings": {
            "title": "Bez ucisku na oczy i rzęsy przez całą noc",
            "description": "<p>Nie. Monté jest zaprojektowana z myślą o osobach, które rezygnowały z masek właśnie z powodu ucisku. Jedwabne wypełnienie unosi tkaninę nad powierzchnią oczu, więc nie ma żadnego kontaktu z gałką oczną ani rzęsami.</p>"
          }
        },
        "detail_4": {
          "type": "item",
          "settings": {
            "title": "Rzep zamiast gumki, nie ściska skroni",
            "description": "<p>Tak. Rzep dopasowujesz raz pod swój obwód głowy i maska trzyma się przez całą noc, nawet jeśli śpisz na boku. 91% klientów potwierdziło, że nie zsunęła się ani razu.</p>"
          }
        }
      },
