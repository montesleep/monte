{{ 'monte-mission.css' | asset_url | stylesheet_tag }}
<script src="{{ 'monte-mission.js' | asset_url }}" defer></script>
<monte-mission class="monte-mission{% if section.settings.center_mobile %} monte-mission--centered{% endif %}" style="--mm-heading: {{ section.settings.heading_color }}; --mm-body: {{ section.settings.body_color }}; --mm-button: {{ section.settings.button_background }}; --mm-button-hover: {{ section.settings.button_hover }}; --mm-button-text: {{ section.settings.button_text }};">
  <div class="monte-mission__content">
    <reveal-items class="monte-mission__copy" margin="0px">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="monte-mission__body">{{ section.settings.body }}</div>{%- endif -%}
    </reveal-items>
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      {%- assign button_label = section.settings.button_label | escape -%}
      {%- render 'button', content: button_label, href: section.settings.button_link -%}
    {%- endif -%}
  </div>
  {%- for side in (1..2) -%}
    <div class="monte-mission__side monte-mission__side--{{ side }}" aria-hidden="true">
      {%- for slot in (1..3) -%}
        {%- liquid
          assign index = slot
          if side == 2
            assign index = slot | plus: 3
          endif
          assign key = 'desktop_' | append: index
          assign image_key = key | append: '_image'
          assign video_key = key | append: '_video'
        -%}
        <div class="monte-mission__item monte-mission__item--{{ index }}">
          <div class="monte-mission__motion">
            {%- render 'monte-mission-media', image: section.settings[image_key], video: section.settings[video_key], index: index -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endfor -%}
  <div class="monte-mission__mobile" aria-hidden="true">
    {%- for index in (1..3) -%}
      {%- liquid
        assign key = 'mobile_' | append: index
        assign image_key = key | append: '_image'
        assign video_key = key | append: '_video'
        assign fallback_index = 1
        if index == 2
          assign fallback_index = 6
        elsif index == 3
          assign fallback_index = 4
        endif
      -%}
      <div class="monte-mission__mobile-item monte-mission__mobile-item--{{ index }}">
        <div class="monte-mission__motion">
          {%- render 'monte-mission-media', image: section.settings[image_key], video: section.settings[video_key], index: fallback_index -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</monte-mission>

