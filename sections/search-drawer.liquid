{{ 'monte-search.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'monte-search.js' | asset_url }}"></script>
<monte-search-drawer id="search-drawer" class="drawer search-drawer monte-search" tabindex="-1" aria-label="{{ 'search.general.title' | t | escape }}" data-section-id="{{ section.id }}" {% if request.design_mode %}handle-section-events{% endif %}
  style="--search-surface: {{ section.settings.background }}; --search-card: {{ section.settings.card_color }}; --search-text: {{ section.settings.text_color }}; --search-secondary: {{ section.settings.secondary_color }}; --search-disabled: {{ section.settings.disabled_color }}; --search-border: {{ section.settings.border_color }}; --search-sale-bg: {{ section.settings.discount_background }}; --search-sale-text: {{ section.settings.discount_color }}; --search-compare: {{ section.settings.compare_color }}; --search-inverse: {{ section.settings.inverse_color }};">
  <form action="{{ routes.search_url }}" method="get" class="monte-search-form" role="search">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <div class="monte-search-header">
      <label class="monte-search-field">
        <span class="sr-only">{{ 'search.general.title' | t }}</span>
        <span class="monte-search-icon" aria-hidden="true">
          <picture class="monte-search-icon--idle"><source media="(min-width: 700px)" srcset="{{ 'monte-search-inactive-desktop.svg' | asset_url }}"><img src="{{ 'monte-search-inactive-mobile.svg' | asset_url }}" width="18.4678" height="18.4678" alt=""></picture>
          <picture class="monte-search-icon--active"><source media="(min-width: 700px)" srcset="{{ 'monte-search-active-desktop.svg' | asset_url }}"><img src="{{ 'monte-search-active-mobile.svg' | asset_url }}" width="18.4678" height="18.4678" alt=""></picture>
        </span>
        <input type="search" name="q" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-controls="MonteSearchResults-{{ section.id }}">
      </label>
      <button type="button" is="close-button" class="monte-search-close link-faded-reverse" aria-label="{{ 'general.accessibility.close' | t | escape }}"><img src="{{ 'monte-search-close.svg' | asset_url }}" width="13.5607" height="13.5607" alt=""></button>
    </div>
    <div class="monte-search-scroll">
      <div class="monte-search-idle" data-search-idle>
        {%- if section.blocks.size > 0 -%}
          <p>{{ section.settings.popular_label | escape }}</p>
          <ul class="monte-search-tags" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank -%}
                <li {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: routes.collections_url }}" class="monte-search-tag">{{ block.settings.label | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div id="MonteSearchResults-{{ section.id }}" data-search-results hidden></div>
      <div class="monte-search-loading" data-search-loading hidden aria-hidden="true"><span class="skeleton skeleton--text"></span></div>
      <div class="empty-state" data-search-error hidden><p>{{ section.settings.error_label | escape }}</p><button type="button" class="link" data-search-retry>{{ section.settings.retry_label | escape }}</button></div>
    </div>
    <span class="sr-only" role="status" aria-live="polite" data-search-status></span>
  </form>
</monte-search-drawer>

{% schema %}
{
  "name": "Search drawer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "paragraph",
      "content": "Live product results appear from 3 characters. All matching products are loaded in the panel. Add up to 5 direct-link tags below."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Czego szukasz?"
    },
    {
      "type": "text",
      "id": "popular_label",
      "label": "Popular searches heading",
      "default": "Popularne wyszukiwania"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Search error message",
      "default": "Nie udało się wczytać wyników."
    },
    {
      "type": "text",
      "id": "retry_label",
      "label": "Retry button label",
      "default": "Spróbuj ponownie"
    },
    {
      "type": "header",
      "content": "Design system colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Panel background",
      "default": "#f8f1e9"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Input, tags and image background",
      "default": "#eee7e0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary text and status badge",
      "default": "#232e71"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary text",
      "default": "#52597e"
    },
    {
      "type": "color",
      "id": "disabled_color",
      "label": "Inactive input text",
      "default": "#9ba0b5"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Input border",
      "default": "#dcd6cf"
    },
    {
      "type": "color",
      "id": "discount_background",
      "label": "Discount badge background",
      "default": "#2f6b57"
    },
    {
      "type": "color",
      "id": "discount_color",
      "label": "Discount badge text",
      "default": "#d9e8e1"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare-at price",
      "default": "#8a2f3a"
    },
    {
      "type": "color",
      "id": "inverse_color",
      "label": "Status badge text",
      "default": "#fdfbf9"
    }
  ],
  "blocks": [
    {
      "type": "popular_search",
      "name": "Monte search tag",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Opens this destination directly. Does not run a text search."
        }
      ]
    }
  ]
}
{% endschema %}
