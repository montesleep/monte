{%- if area == 'primary' -%}
  {%- liquid
    assign shop_label = section.settings.shop_label | default: 'Sklep'
    assign mega_menu_block = section.blocks | where: 'type', 'mega_menu' | first
  -%}
  <nav class="header__link-list monte-header-navigation" aria-label="{{ shop_label | escape }}">
    <ul class="contents" role="list">
      <li>
        <details is="monte-mega-menu-disclosure" class="monte-shop-disclosure" trigger="click" {% if mega_menu_block %}{{ mega_menu_block.shopify_attributes }}{% endif %}>
          <summary class="monte-header-link text-with-icon link-faded-reverse">
            {{- shop_label | escape -}}
            <img class="monte-header-chevron" src="{{ 'monte-header-chevron.svg' | asset_url }}" width="10" height="7" alt="">
          </summary>
          <div class="mega-menu monte-mega-menu">
            {%- render 'monte-navigation-items', section: section, kind: 'collection', desktop: true -%}
            {%- render 'monte-navigation-promo', section: section, desktop: true -%}
          </div>
        </details>
      </li>
      <li>
        <a class="monte-header-link link-faded-reverse" href="{{ section.settings.bundles_link | default: routes.collections_url }}">{{ section.settings.bundles_label | escape }}</a>
      </li>
    </ul>
  </nav>
{%- else -%}
  <nav class="header__link-list monte-header-navigation" aria-label="{{ section.settings.contact_label | escape }}">
    <ul class="contents" role="list">
      <li>
        <details class="relative monte-contact-disclosure" is="dropdown-disclosure" trigger="click">
          <summary class="monte-header-link text-with-icon link-faded-reverse">
            {{- section.settings.contact_label | escape -}}
            <img class="monte-header-chevron" src="{{ 'monte-header-chevron.svg' | asset_url }}" width="10" height="7" alt="">
          </summary>
          <div class="dropdown-menu dropdown-menu--restrictable monte-header-contact">
            <ul class="contents" role="list">
              {%- if section.settings.secondary_menu.links.size > 0 -%}
                {%- for link in section.settings.secondary_menu.links -%}
                  <li><a class="dropdown-menu__item group" href="{{ link.url }}"><span class="reversed-link">{{ link.title }}</span></a></li>
                {%- endfor -%}
              {%- else -%}
                <li><a class="dropdown-menu__item group" href="{{ section.settings.contact_link | default: pages.contact.url }}"><span class="reversed-link">{{ section.settings.contact_label | escape }}</span></a></li>
              {%- endif -%}
            </ul>
          </div>
        </details>
      </li>
    </ul>
  </nav>
{%- endif -%}
