{{ 'monte-cart.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'monte-cart.js' | asset_url }}"></script>
<style>@font-face { font-family: 'PP Mori Extrabold'; src: url('https://cdn.shopify.com/s/files/1/1018/4258/3886/files/PPMori-Extrabold.ttf?v=1788241598') format('truetype'); font-weight: 800; font-style: normal; font-display: swap; }</style>
{%- capture amount_placeholder -%}{% raw %}{{ amount }}{% endraw %}{%- endcapture -%}
<monte-cart-drawer id="cart-drawer" class="cart-drawer drawer drawer--lg monte-cart" tabindex="-1" aria-labelledby="MonteCartTitle" data-section-id="{{ section.id }}" data-error="{{ section.settings.error_message | escape }}" data-limit="{{ section.settings.limit_message | escape }}" data-updated="{{ section.settings.updated_message | escape }}" {% if request.design_mode %}handle-section-events{% endif %}
  style="--cart-surface: {{ section.settings.background }}; --cart-card: {{ section.settings.card_color }}; --cart-text: {{ section.settings.text_color }}; --cart-secondary: {{ section.settings.secondary_color }}; --cart-border: {{ section.settings.border_color }}; --cart-compare: {{ section.settings.compare_color }}; --cart-savings: {{ section.settings.savings_color }}; --cart-inverse: {{ section.settings.inverse_color }}; --cart-hover: {{ section.settings.hover_color }};">
  <div class="monte-cart-shell">
    <div class="monte-cart-header">
      <div class="monte-cart-heading"><h2 id="MonteCartTitle">{{ section.settings.title | escape }}</h2>{% render 'monte-cart-icon', icon: 'dot' %}<cart-count class="monte-cart-count">{{ cart.item_count }}</cart-count></div>
      <button type="button" is="close-button" class="monte-cart-close link-faded-reverse" aria-label="{{ 'general.accessibility.close' | t | escape }}">{% render 'monte-cart-icon', icon: 'close' %}</button>
    </div>
    <monte-cart-shipping class="free-shipping-bar monte-cart-shipping" threshold="{{ section.settings.shipping_threshold | at_least: 0 | times: 100 }}" total-price="{{ cart.total_price }}" reached-message="{{ section.settings.shipping_success | escape }}" unreached-message="{{ section.settings.shipping_message | replace: '[amount]', amount_placeholder | escape }}">
      <span>&nbsp;</span><progress-bar class="progress-bar" role="progressbar" aria-label="{{ section.settings.shipping_success | strip_html | escape }}" aria-valuemin="0" style="--progress: 0"></progress-bar>
    </monte-cart-shipping>
    <p class="monte-cart-feedback" role="alert" data-cart-error hidden></p>
    <p class="sr-only" role="status" aria-live="polite" data-cart-status></p>
    <div class="monte-cart-view" data-item-count="{{ cart.item_count }}">
      <div class="monte-cart-scroll" tabindex="-1">
        {%- if cart.empty? -%}
          <div class="monte-cart-empty">
            <div class="monte-cart-empty-copy">
              <div class="monte-cart-illustration {% if section.settings.empty_image == blank and section.settings.empty_video == blank %}monte-cart-illustration--default{% endif %}">
                {%- if section.settings.empty_video != blank -%}{{ section.settings.empty_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
                {%- elsif section.settings.empty_image != blank -%}{{ section.settings.empty_image | image_url: width: 440 | image_tag: sizes: '220px', widths: '172,220,344,440' }}
                {%- else -%}<img src="{{ 'monte-cart-empty.png' | asset_url }}" width="220" height="220" alt="">{%- endif -%}
              </div>
              <h3>{{ section.settings.empty_heading | escape }}</h3><p>{{ section.settings.empty_text | escape }}</p>
            </div>
            <div class="monte-cart-recommendations">{%- for recommended_product in section.settings.empty_products -%}{%- render 'monte-cart-recommendation', product: recommended_product, mode: 'empty', section: section -%}{%- endfor -%}</div>
          </div>
        {%- else -%}
          <div class="monte-cart-lines">{%- render 'monte-cart-lines', cart: cart, section: section -%}</div>
          {%- if section.settings.products.count > 0 -%}
            <section class="monte-cart-upsell" aria-labelledby="MonteCartUpsellTitle">
              <div class="monte-cart-upsell-heading"><h3 id="MonteCartUpsellTitle">{{ section.settings.recommendations_title | escape }}</h3><div class="monte-cart-arrows">
                <button type="button" data-carousel-direction="-1" aria-label="{{ 'general.accessibility.previous' | t | escape }}" aria-controls="MonteCartCarousel">{% render 'monte-cart-icon', icon: 'previous' %}</button>
                <button type="button" data-carousel-direction="1" aria-label="{{ 'general.accessibility.next' | t | escape }}" aria-controls="MonteCartCarousel">{% render 'monte-cart-icon', icon: 'next' %}</button>
              </div></div>
              <scroll-carousel id="MonteCartCarousel" class="monte-cart-carousel scroll-area" tabindex="0" role="region" aria-label="{{ section.settings.recommendations_title | escape }}">{%- for recommended_product in section.settings.products -%}{%- render 'monte-cart-recommendation', product: recommended_product, mode: 'upsell', section: section -%}{%- endfor -%}</scroll-carousel>
              <div class="monte-cart-carousel-track" aria-hidden="true"><span></span></div>
            </section>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- unless cart.empty? -%}
        {%- liquid
          assign compare_total = 0
          for line_item in cart.items
            assign compare_line = line_item.variant.compare_at_price | default: line_item.original_price | at_least: line_item.original_price | times: line_item.quantity
            assign compare_total = compare_total | plus: compare_line
          endfor
          assign savings = compare_total | minus: cart.total_price | at_least: 0
        -%}
        <form action="{{ routes.cart_url }}" method="post" class="monte-cart-footer">
          <div class="monte-cart-totals"><p class="monte-cart-savings"><span>{{ section.settings.savings_label | escape }}</span><span>{{ savings | money_without_trailing_zeros }}</span></p>
            {%- for discount in cart.cart_level_discount_applications -%}<p class="monte-cart-discount"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span></p>{%- endfor -%}
            <p><span>{{ section.settings.total_label | escape }}</span>{% render 'monte-cart-price', price: cart.total_price, compare_price: compare_total %}</p>
          </div>
          <button type="submit" name="checkout" class="monte-cart-button monte-cart-button--primary monte-cart-checkout">{{ section.settings.checkout_label | escape }}{% render 'monte-cart-icon', icon: 'checkout' %}</button>
          <div class="monte-cart-trust">{% for n in (1..2) %}{% assign text_key = 'trust_text_' | append: n %}{% assign icon_key = 'trust_icon_' | append: n %}{% if section.settings[text_key] != blank %}<span>{% if section.settings[icon_key] != blank %}{{ section.settings[icon_key] | image_url: width: 40 | image_tag: width: 20, height: 20, alt: '' }}{% elsif n == 1 %}{% render 'monte-cart-icon', icon: 'shipping' %}{% else %}{% render 'monte-cart-icon', icon: 'return' %}{% endif %}{{ section.settings[text_key] | escape }}</span>{% endif %}{% endfor %}</div>
        </form>
      {%- endunless -%}
    </div>
  </div>
</monte-cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "class": "shopify-section--cart-drawer",
  "tag": "section",
  "settings": [
    {"type":"checkbox","id":"split_title_color","label":"Show title suffix as color","default":true,"info":"For single-variant products named Product - Color, show the suffix as a separate color label."},
    {"type":"color","id":"background","label":"Drawer background","default":"#f8f1e9"},
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Mój koszyk"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add button label",
      "default": "Dodaj"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Przejdź do kasy"
    },
    {
      "type": "text",
      "id": "color_label",
      "label": "Color label",
      "default": "Kolor:"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings label",
      "default": "Oszczędzasz:"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Razem:"
    },
    {
      "type": "header",
      "content": "Free shipping"
    },
    {
      "type": "number",
      "id": "shipping_threshold",
      "label": "Free shipping threshold",
      "info": "Amount in the store currency. This display does not change shipping rates in Shopify.",
      "default": 250
    },
    {
      "type": "inline_richtext",
      "id": "shipping_message",
      "label": "Progress message",
      "info": "Use [amount] for the remaining amount including currency.",
      "default": "Brakuje Ci [amount] do <strong>darmowej dostawy</strong>"
    },
    {
      "type": "inline_richtext",
      "id": "shipping_success",
      "label": "Success message",
      "default": "<strong>Darmowa dostawa</strong> dla Twojego zamówienia!"
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "image_picker",
      "id": "empty_image",
      "label": "Illustration",
      "info": "Optional. Uses the design illustration when empty."
    },
    {
      "type": "video",
      "id": "empty_video",
      "label": "Illustration video",
      "info": "Overrides the image. Plays automatically, muted and without player controls."
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Twój koszyk jest pusty"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Description",
      "default": "Nie wiesz, od czego zacząć? Oto nasze bestsellery."
    },
    {
      "type": "product_list",
      "id": "empty_products",
      "label": "Recommended products",
      "limit": 3,
      "info": "Manually choose up to 3 products. The first available variant is selected by default."
    },
    {
      "type": "header",
      "content": "Filled cart"
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Upsell heading",
      "default": "Może Ci się spodobać"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Upsell products",
      "limit": 10,
      "info": "Separate from empty-cart recommendations. Products remain visible after adding."
    },
    {
      "type": "text",
      "id": "trust_text_1",
      "label": "Trust message 1",
      "default": "Wysyłka tego samego dnia"
    },
    {
      "type": "image_picker",
      "id": "trust_icon_1",
      "label": "Trust icon 1",
      "info": "Optional. Uses the design icon when empty."
    },
    {
      "type": "text",
      "id": "trust_text_2",
      "label": "Trust message 2",
      "default": "30 dni na zwrot"
    },
    {
      "type": "image_picker",
      "id": "trust_icon_2",
      "label": "Trust icon 2",
      "info": "Optional. Uses the design icon when empty."
    },
    {
      "type": "header",
      "content": "Feedback"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Request error",
      "default": "Nie udało się zaktualizować koszyka. Spróbuj ponownie."
    },
    {
      "type": "text",
      "id": "limit_message",
      "label": "Quantity limit message",
      "default": "Możesz dodać maksymalnie 50 sztuk tego wariantu."
    },
    {
      "type": "text",
      "id": "updated_message",
      "label": "Screen reader update",
      "default": "Koszyk został zaktualizowany."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#eee7e0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and accent",
      "default": "#232e71"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary text",
      "default": "#52597e"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#dcd6cf"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare-at price",
      "default": "#8a2f3a"
    },
    {
      "type": "color",
      "id": "savings_color",
      "label": "Savings",
      "default": "#2f6b57"
    },
    {
      "type": "color",
      "id": "inverse_color",
      "label": "Button text",
      "default": "#fdfbf9"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Primary button hover",
      "default": "#182153"
    }
  ]
}
{% endschema %}
