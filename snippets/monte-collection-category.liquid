<a class="monte-categories__item{% if active %} is-active{% endif %}" href="{{ url }}"{% if active %} aria-current="page"{% endif %}>
  <span class="monte-categories__icon" aria-hidden="true">
    <span class="monte-categories__image">
      {%- if image != blank -%}
        {{- image | image_url: width: 180 | image_tag: widths: '60,120,180', sizes: '60px', loading: 'lazy', alt: '' -}}
      {%- endif -%}
    </span>
    <svg class="monte-categories__ring" width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><circle cx="32" cy="32" r="31" pathLength="100" /></svg>
  </span>
  <span class="monte-categories__label reversed-link">{{ title | escape }}</span>
</a>
