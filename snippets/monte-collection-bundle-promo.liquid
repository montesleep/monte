{%- liquid
  assign promo_settings = promo_settings | default: section.settings
  assign mobile_image = promo_settings.bundle_mobile_image
  assign mobile_video = promo_settings.bundle_mobile_video
  if mobile_image == blank and mobile_video == blank
    assign mobile_image = promo_settings.bundle_image
    assign mobile_video = promo_settings.bundle_video
  endif
-%}
<article class="monte-catalog-promo" style="--promo-text: {{ promo_settings.bundle_text }}; --promo-button: {{ promo_settings.bundle_button_bg }}; --promo-button-text: {{ promo_settings.bundle_button_text }}; --promo-button-hover: {{ promo_settings.bundle_button_hover }};">
  <div class="monte-catalog-promo__media monte-catalog-promo__media--desktop{% if promo_settings.bundle_image == blank and promo_settings.bundle_video == blank %} monte-catalog-promo__media--default{% endif %}">
    {%- render 'monte-navigation-media', image: promo_settings.bundle_image, video: promo_settings.bundle_video, placeholder: 'lifestyle-1', sizes: '(min-width: 700px) 25vw, 100vw', width: 2327, height: 1080 -%}
  </div>
  <div class="monte-catalog-promo__media monte-catalog-promo__media--mobile">
    {%- render 'monte-navigation-media', image: mobile_image, video: mobile_video, placeholder: 'lifestyle-1', sizes: '100vw', width: 2327, height: 1080 -%}
  </div>
  <div class="monte-catalog-promo__content">
    <div class="monte-catalog-promo__copy">
      {%- if promo_settings.bundle_heading != blank -%}<h2>{{ promo_settings.bundle_heading | escape }}</h2>{%- endif -%}
      {%- if promo_settings.bundle_body != blank -%}<p>{{ promo_settings.bundle_body | escape }}</p>{%- endif -%}
    </div>
    {%- if promo_settings.bundle_button != blank -%}
      <a class="button monte-catalog-promo__button" href="{{ promo_settings.bundle_link | default: '/pages/bundle-builder' }}">{{ promo_settings.bundle_button | escape }}</a>
    {%- endif -%}
  </div>
</article>
