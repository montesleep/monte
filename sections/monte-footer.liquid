{{ 'monte-footer.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'monte-footer.js' | asset_url }}"></script>
{%- liquid
  assign nav_blocks = section.blocks | where: 'type', 'nav_column'
  assign social_blocks = section.blocks | where: 'type', 'social_icon'
  assign payment_blocks = section.blocks | where: 'type', 'payment_icon'
-%}
<footer class="mfooter" style="--footer-background: {{ section.settings.card_background }}; --footer-text: {{ section.settings.text_color }}; --footer-light: {{ section.settings.light_color }}; --footer-hover: {{ section.settings.hover_color }}; --footer-accent: {{ section.settings.accent_color }};">
  <div class="mfooter__card">
    <reveal-items class="mfooter__top">
      <div class="mfooter__brand">
        {%- if section.settings.brand_logo != blank -%}
          <div class="mfooter__column-header"><a class="mfooter__brand-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ section.settings.brand_logo | image_url: width: 508 | image_tag: loading: 'lazy', widths: '127,254,508', sizes: '127px', alt: shop.name }}</a></div>
        {%- endif -%}
        {%- if section.settings.brand_description != blank -%}<p class="mfooter__description">{{ section.settings.brand_description | escape | newline_to_br }}</p>{%- endif -%}
        {%- capture social_content -%}
          {%- for block in social_blocks limit: 4 -%}
            {%- if block.settings.icon != blank -%}
              <a class="mfooter__social link-faded-reverse" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %} aria-label="{{ block.settings.label | default: block.settings.icon.alt | default: 'Social media' | escape }}" {{ block.shopify_attributes }}>{{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', widths: '24,48,96', sizes: '24px' }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if social_content != blank -%}<div class="mfooter__socials">{{ social_content }}</div>{%- endif -%}
      </div>
      {%- for block in nav_blocks -%}
        <div class="mfooter__nav-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h2 class="mfooter__column-header mfooter__col-heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul class="mfooter__nav-links" role="list">{%- for link in block.settings.menu.links -%}<li><a class="link-faded" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{%- endfor -%}</ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
      <div class="mfooter__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}<h2 class="mfooter__column-header mfooter__col-heading">{{ section.settings.newsletter_heading | escape }}</h2>{%- endif -%}
        <div class="mfooter__newsletter-content">
          {%- if section.settings.newsletter_desc != blank -%}<p class="mfooter__description">{{ section.settings.newsletter_desc | escape | newline_to_br }}</p>{%- endif -%}
          <monte-footer-newsletter data-public-key="{{ settings.klaviyo_public_api_key | strip | escape }}" data-list-id="{{ settings.klaviyo_list_id | strip | escape }}" data-success="{{ section.settings.newsletter_success | escape }}" data-error="{{ section.settings.newsletter_error | escape }}">
            <form class="mfooter__newsletter-form" onsubmit="return false;">
              <label class="sr-only" for="FooterEmail-{{ section.id }}">{{ section.settings.newsletter_placeholder | escape }}</label>
              <div class="mfooter__input-row">
                <input id="FooterEmail-{{ section.id }}" class="mfooter__email-input" type="email" name="email" placeholder="{{ section.settings.newsletter_placeholder | escape }}" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false">
                <button type="submit" class="mfooter__submit-btn" aria-label="{{ section.settings.newsletter_submit_label | escape }}"><img src="{{ 'monte-footer-arrow.svg' | asset_url }}" width="12" height="9" alt=""></button>
              </div>
              <p class="mfooter__form-message" role="status" aria-live="polite" hidden></p>
            </form>
          </monte-footer-newsletter>
        </div>
      </div>
    </reveal-items>
    {%- if section.settings.logo != blank -%}<reveal-items class="mfooter__wordmark"><div>{{ section.settings.logo | image_url: width: 2800 | image_tag: loading: 'lazy', widths: '343,686,1360,2000,2800', sizes: '(min-width: 1100px) calc(100vw - 80px), calc(100vw - 32px)', alt: shop.name }}</div></reveal-items>{%- endif -%}
    <reveal-items class="mfooter__bottom">
      <div class="mfooter__credits">
        {%- if section.settings.copyright_text != blank -%}<p class="mfooter__copyright">{{ section.settings.copyright_text | escape }}</p>{%- endif -%}
        {%- capture payment_content -%}
          {%- for block in payment_blocks limit: 10 -%}{%- if block.settings.icon != blank -%}<span class="mfooter__payment-badge" {{ block.shopify_attributes }}>{{ block.settings.icon | image_url: width: 140 | image_tag: loading: 'lazy', alt: block.settings.label, sizes: '35px', widths: '35,70,140' }}</span>{%- endif -%}{%- endfor -%}
        {%- endcapture -%}
        {%- if payment_content != blank -%}<div class="mfooter__payments" aria-label="Payment methods">{{ payment_content }}</div>{%- endif -%}
      </div>
    </reveal-items>
  </div>
</footer>

{% schema %}
{
  "name": "Monté Footer",
  "tag": "section",
  "class": "shopify-section--monte-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand logo"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Jedwabne akcesoria do snu i pielęgnacji włosów. Wysyłamy z Polski."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Footer background",
      "default": "#182153"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#fdfbf9"
    },
    {
      "type": "color",
      "id": "light_color",
      "label": "Light buttons and input",
      "default": "#f8f1e9"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Light hover background",
      "default": "#eee7e0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Input text and submit button",
      "default": "#232e71"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "paragraph",
      "content": "Configure Klaviyo Public API Key and Klaviyo List ID under Theme settings → Klaviyo. When either field is empty, the form validates the email without submitting it."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Dołącz do rytuału"
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Description",
      "default": "Odbierz darmową dostawę na pierwsze zamówienie i bądź na bieżąco z nowościami Monté."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Twój adres e-mail"
    },
    {
      "type": "text",
      "id": "newsletter_submit_label",
      "label": "Submit button accessibility label",
      "default": "Zapisz się"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Dziękujemy! Jeśli otrzymasz wiadomość z potwierdzeniem, kliknij w niej link, aby dokończyć zapis."
    },
    {
      "type": "text",
      "id": "newsletter_error",
      "label": "Error message",
      "default": "Nie udało się wysłać formularza. Spróbuj ponownie za chwilę."
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Large wordmark image",
      "info": "Remove the image to hide the wordmark. Its original aspect ratio is preserved."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 Monté. Wszystkie prawa zastrzeżone."
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Store"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ],
      "limit": 2
    },
    {
      "type": "payment_icon",
      "name": "Payment icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Payment icon image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Alt text (e.g. Visa)",
          "default": "Payment method"
        }
      ],
      "limit": 10
    },
    {
      "type": "social_icon",
      "name": "Social icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "This item is hidden when no icon is selected."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessibility label",
          "default": "Social media"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Monté Footer",
      "blocks": [
        {
          "type": "nav_column",
          "settings": {
            "heading": "Sklep",
            "menu": "footer"
          }
        },
        {
          "type": "nav_column",
          "settings": {
            "heading": "Informacje prawne",
            "menu": "footer"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 16
}
{% endschema %}
