{{ 'monte-collection-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign desktop_image = section.settings.image
  assign desktop_video = section.settings.video
  assign mobile_image = section.settings.mobile_image
  assign mobile_video = section.settings.mobile_video
  if mobile_image == blank and mobile_video == blank
    assign mobile_image = desktop_image
    assign mobile_video = desktop_video
  endif
  assign rating = settings.monte_social_rating | default: 4.5 | at_least: 0 | at_most: 5
  assign rating_text = shop.metafields.custom.rating_text_social.value
-%}
<style>
  #shopify-section-{{ section.id }} { background: transparent; margin: 0; padding: 0; }
</style>
<reveal-items class="monte-collection-hero" selector=".monte-collection-hero__content" margin="0px" style="--mch-height-desktop: {{ section.settings.desktop_height }}px; --mch-height-mobile: {{ section.settings.mobile_height }}px; --mch-heading: {{ section.settings.heading_color }}; --mch-body: {{ section.settings.body_color }}; --mch-rating: {{ section.settings.rating_color }}; --mch-overlay: {{ section.settings.overlay_color }}; --mch-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --mch-image-position: {{ desktop_image.presentation.focal_point | default: '50% 50%' }}; --mch-mobile-image-position: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};">
  <div class="monte-collection-hero__frame{% if section.settings.mobile_gradient %} monte-collection-hero__frame--gradient{% endif %}">
    <div class="monte-collection-hero__media" aria-hidden="true">
      {%- if desktop_video == blank and mobile_video == blank -%}
        <picture>
          {%- if mobile_image != blank -%}
            <source media="(max-width: 699px)" srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 800 }} 800w, {{ mobile_image | image_url: width: 1200 }} 1200w" sizes="calc(100vw - 8px)" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
          {%- elsif section.settings.show_default_images -%}
            <source media="(max-width: 699px)" srcset="{{ 'monte-collection-hero-mobile.png' | asset_url }}" width="932" height="1308">
          {%- endif -%}
          {%- if desktop_image != blank -%}
            {{- desktop_image | image_url: width: 3200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,800,1000,1200,1600,2000,2400,3200', sizes: '(min-width: 700px) calc(100vw - 16px), calc(100vw - 8px)', alt: '' -}}
          {%- elsif section.settings.show_default_images -%}
            <img src="{{ 'monte-collection-hero-desktop.png' | asset_url }}" width="1746" height="810" loading="eager" fetchpriority="high" alt="">
          {%- elsif mobile_image != blank -%}
            {{- mobile_image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,800,1200,1600', sizes: '100vw', alt: '' -}}
          {%- endif -%}
        </picture>
      {%- else -%}
        {%- for device in (1..2) -%}
          {%- liquid
            assign device_class = 'desktop'
            assign hero_video = desktop_video
            assign hero_image = desktop_image
            assign default_image = 'monte-collection-hero-desktop.png'
            assign image_width = 1746
            assign image_height = 810
            if device == 2
              assign device_class = 'mobile'
              assign hero_video = mobile_video
              assign hero_image = mobile_image
              assign default_image = 'monte-collection-hero-mobile.png'
              assign image_width = 932
              assign image_height = 1308
            endif
          -%}
          <div class="monte-collection-hero__{{ device_class }}">
            {%- if hero_video != blank -%}
              {%- render 'media', media: hero_video, autoplay: true, loop: true, show_play_button: true, preload: true, sizes: '100vw' -%}
            {%- elsif hero_image != blank -%}
              {{- hero_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '400,600,800,1200,1600,2000,2400', sizes: '100vw', alt: '' -}}
            {%- elsif section.settings.show_default_images -%}
              <img src="{{ default_image | asset_url }}" width="{{ image_width }}" height="{{ image_height }}" loading="eager" alt="">
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="monte-collection-hero__overlay" aria-hidden="true"></div>
    <div class="monte-collection-hero__content">
      {%- if section.settings.show_rating -%}
        <div class="monte-collection-hero__rating">
          {%- render 'monte-social-rating', rating: rating -%}
          {%- if rating_text != blank -%}<p>{{ rating_text | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="monte-collection-hero__copy">
          {%- if section.settings.heading != blank -%}<h1 class="monte-collection-hero__heading">{{ section.settings.heading | escape | newline_to_br }}</h1>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="monte-collection-hero__subheading">{{ section.settings.subheading | escape | newline_to_br }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</reveal-items>

{% schema %}
{
  "name": "Monté Collection Hero",
  "class": "shopify-section--collection-banner",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Shared by every collection using this template. Images, copy and colors are edited here. The rating is shared with the homepage." },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "video", "id": "video", "label": "Desktop video", "info": "Replaces the desktop image. Plays automatically, muted, looping and without controls." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "video", "id": "mobile_video", "label": "Mobile video", "info": "Replaces the mobile image. If both mobile fields are empty, selected desktop media is used." },
    { "type": "checkbox", "id": "show_default_images", "label": "Show design images when no media is selected", "default": true },
    { "type": "range", "id": "desktop_height", "label": "Desktop minimum height", "min": 300, "max": 800, "step": 20, "unit": "px", "default": 460 },
    { "type": "range", "id": "mobile_height", "label": "Mobile minimum height", "min": 300, "max": 800, "step": 20, "unit": "px", "default": 420 },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Cała kolekcja Monté" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Maski, poszewki, czepki i gumki,\n100% jedwab morwowy, 22 momme." },
    { "type": "checkbox", "id": "show_rating", "label": "Show shared rating", "default": true },
    { "type": "paragraph", "content": "Text uses the shop metafield custom.rating_text_social. Stars use Theme settings > Monté social rating > Filled stars." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FDFBF9" },
    { "type": "color", "id": "body_color", "label": "Subheading", "default": "#FDFBF9" },
    { "type": "color", "id": "rating_color", "label": "Rating text", "default": "#FDFBF9" },
    { "type": "color", "id": "overlay_color", "label": "Image overlay", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 20 },
    { "type": "checkbox", "id": "mobile_gradient", "label": "Add mobile bottom gradient", "info": "Adds the design's dark gradient behind the content. Text and rating remain unaffected.", "default": true }
  ]
}
{% endschema %}
