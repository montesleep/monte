{%- liquid
  assign fallback = ''
  if show_default
    case index
      when 1
        assign fallback = 'monte-about-hero.jpg'
      when 2
        assign fallback = 'monte-spotlight-masks.png'
      when 3
        assign fallback = 'monte-faq-hero-desktop.png'
      when 4
        assign fallback = 'monte-spotlight-pillows.png'
      when 5
        assign fallback = 'monte-about-mission5.jpg'
      when 6
        assign fallback = 'monte-collection-hero-desktop.png'
    endcase
  endif
-%}
{%- render 'monte-navigation-media', image: image, video: video, placeholder: fallback, width: 600, height: 600, sizes: '(min-width: 1000px) 320px, 180px' -%}

