{%- paginate search.results by 50 -%}
  <div data-search-page data-next-url="{{ paginate.next.url | escape }}" data-products-label="{{ 'search.general.products' | t | escape }}">
    <div class="empty-state" data-search-empty{% if search.results_count > 0 %} hidden{% endif %}><p class="h6">{{ 'search.general.no_results' | t }}</p></div>
    <div class="monte-search-grid">
      {%- for product in search.results -%}
        {%- if product.object_type == 'product' -%}
          {%- render 'monte-search-product-card', product: product -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endpaginate -%}
{% schema %}
{"name":"Monte search results","settings":[]}
{% endschema %}
