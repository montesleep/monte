{%- comment -%}Shared Monté social rating using the original Figma base, fill and star layers.{%- endcomment -%}
<div class="monte-social-rating" role="img" aria-label="{{ rating | replace: '.', ',' }} z 5 gwiazdek">
  {%- for star in (1..5) -%}
    {%- assign previous_stars = star | minus: 1 -%}
    {%- assign fill_percent = rating | minus: previous_stars | at_least: 0 | at_most: 1 | times: 100 -%}
    <span class="monte-social-rating__star" aria-hidden="true">
      <img src="{{ 'monte-rating-base.svg' | asset_url }}" width="16" height="16" alt="">
      {%- if fill_percent == 50 -%}
        <img src="{{ 'monte-rating-half-background.svg' | asset_url }}" width="8" height="16" alt="">
      {%- elsif fill_percent > 0 -%}
        <img src="{{ 'monte-rating-background.svg' | asset_url }}" width="16" height="16" alt="" style="clip-path: inset(0 {{ 100 | minus: fill_percent }}% 0 0);">
      {%- endif -%}
      <img class="monte-social-rating__glyph" src="{{ 'monte-rating-glyph.svg' | asset_url }}" width="12.618" height="12" alt="">
    </span>
  {%- endfor -%}
</div>
