{%- assign source = collection | default: collections.all -%}
{%- paginate source.products by 24 -%}
<div data-builder-catalog>
  <reveal-items selector=".mb-card" margin="0px"><div class="mb-grid">{%- for product in source.products -%}{% render 'monte-builder-card', product: product %}{%- else -%}<p class="mb-no-products">{{ 'collection.general.empty_collection' | t }}</p>{%- endfor -%}</div></reveal-items>
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="mb-button mb-button--outline mb-more" data-builder-more>Pokaż więcej</a>{%- endif -%}
</div>
{%- endpaginate -%}
