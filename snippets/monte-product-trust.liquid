{%- assign trust_settings = block.settings | default: settings -%}
<reveal-items class="mp-trust" {{ block.shopify_attributes }} margin="0px" style="--trust-bg:{{ trust_settings.monte_trust_bg | default: '#E3E5F0' }};--trust-text:{{ trust_settings.monte_trust_text | default: '#232E71' }};--shipping-color:{{ trust_settings.monte_shipping_color | default: '#232E71' }}">
  <div class="mp-trust-pills">{%- for i in (1..6) -%}{%- assign key = 'monte_trust_' | append: i | append: '_text' -%}{%- assign icon_key = 'monte_trust_' | append: i | append: '_icon' -%}{%- assign bg_key = 'monte_trust_' | append: i | append: '_bg' -%}{%- assign color_key = 'monte_trust_' | append: i | append: '_color' -%}{%- if trust_settings[key] != blank -%}<span style="background:{{ trust_settings[bg_key] | default: trust_settings.monte_trust_bg }};color:{{ trust_settings[color_key] | default: trust_settings.monte_trust_text }}">{%- if trust_settings[icon_key] != blank -%}{{ trust_settings[icon_key] | image_url: width: 40 | image_tag: width: 20, height: 20, loading: 'lazy' }}{%- elsif i == 3 -%}<img src="{{ 'monte-pdp-poland.svg' | asset_url }}" width="20" height="20" alt="">{%- endif -%}{{ trust_settings[key] | escape }}</span>{%- endif -%}{%- endfor -%}</div>
  {%- if trust_settings.monte_shipping_text != blank -%}<div class="mp-shipping" style="background:{{ trust_settings.monte_shipping_bg | default: 'transparent' }}">{%- if trust_settings.monte_shipping_icon != blank -%}{{ trust_settings.monte_shipping_icon | image_url: width: 40 | image_tag: width: 20, height: 20, loading: 'lazy' }}{%- else -%}<span class="mp-clock"><img src="{{ 'monte-pdp-clock.svg' | asset_url }}" width="18.6875" height="18.6875" alt=""></span>{%- endif -%}<span>{{ trust_settings.monte_shipping_text }}</span></div>{%- endif -%}
  <div class="mp-payments">{%- for i in (1..10) -%}{%- assign key = 'monte_payment_' | append: i -%}{%- if trust_settings[key] != blank -%}{{ trust_settings[key] | image_url: width: 100 | image_tag: loading: 'lazy', height: 24 }}{%- endif -%}{%- endfor -%}</div>
</reveal-items>
