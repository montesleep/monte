{{ 'monte-collection-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign design_images = design_images | default: section.settings.design_images
  assign hero_heading = hero_heading | default: section.settings.heading
  assign hero_subheading = hero_subheading | default: section.settings.subheading
  assign desktop_image = section.settings.image
  assign desktop_video = section.settings.video
  assign mobile_image = section.settings.mobile_image
  assign mobile_video = section.settings.mobile_video
  if mobile_image == blank and mobile_video == blank
    assign mobile_image = desktop_image
    assign mobile_video = desktop_video
  endif
  assign rating = settings.monte_social_rating | default: 4.5 | at_least: 0 | at_most: 5
  assign rating_text = shop.metafields.custom.rating_text_social.value
-%}
{%- assign campaign_slot = '' -%}
{%- if design_images == 'builder' -%}{%- assign campaign_slot = 'builder_intro' -%}
{%- elsif request.page_type == 'collection' or request.page_type == 'list-collections' -%}{%- assign campaign_slot = 'collection_hero' -%}{%- endif -%}
{%- capture campaign_handle -%}{%- render 'monte-campaign-slot', slot: campaign_slot -%}{%- endcapture -%}
{%- assign campaign_content = metaobjects.monte_campaign_placement[campaign_handle] -%}
{%- liquid
  assign hero_heading = campaign_content.heading.value | default: hero_heading
  assign hero_subheading = campaign_content.body.value | default: hero_subheading
  assign hero_badge = campaign_content.badge.value | default: section.settings.badge_text
-%}
{%- liquid
  assign campaign_desktop = campaign_content.desktop_media.value
  assign campaign_mobile = campaign_content.mobile_media.value
  if campaign_desktop.media_type == 'image' or campaign_desktop.media_type == 'video'
    assign desktop_image = nil
    assign desktop_video = nil
    if campaign_desktop.media_type == 'video'
      assign desktop_video = campaign_desktop
    else
      assign desktop_image = campaign_desktop
    endif
    assign mobile_image = desktop_image
    assign mobile_video = desktop_video
  endif
  if campaign_mobile.media_type == 'image' or campaign_mobile.media_type == 'video'
    assign mobile_image = nil
    assign mobile_video = nil
    if campaign_mobile.media_type == 'video'
      assign mobile_video = campaign_mobile
    else
      assign mobile_image = campaign_mobile
    endif
  endif
-%}
{%- unless campaign_handle == '__hidden__' -%}
<style>
  #shopify-section-{{ section.id }} { background: transparent; margin: 0; padding: 0; }
</style>
<reveal-items class="monte-collection-hero{% if design_images == 'about' %} monte-collection-hero--about{% endif %}" selector=".monte-collection-hero__content" margin="0px" style="--mch-gradient-opacity: {% if design_images == 'faq' or design_images == 'policy' or design_images == 'contact' or design_images == 'about' or design_images == 'builder' %}.7{% else %}.8{% endif %}; --mch-height-desktop: {{ section.settings.desktop_height }}px; --mch-height-mobile: {{ section.settings.mobile_height }}px; --mch-heading: {{ campaign_content.text_color.value | default: section.settings.heading_color }}; --mch-body: {{ campaign_content.text_color.value | default: section.settings.body_color }}; --mch-rating: {{ section.settings.rating_color }}; --mch-overlay: {{ section.settings.overlay_color }}; --mch-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --mch-image-position: {{ desktop_image.presentation.focal_point | default: '50% 50%' }}; --mch-mobile-image-position: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};">
  <div class="monte-collection-hero__frame{% if section.settings.mobile_gradient %} monte-collection-hero__frame--gradient{% endif %}">
    <div class="monte-collection-hero__media" aria-hidden="true">
      {%- if design_images == 'about' and desktop_image == blank and desktop_video == blank and mobile_image == blank and mobile_video == blank -%}
        <picture>
          <source media="(max-width: 699px)" srcset="{{ 'monte-about-hero-mobile.webp' | asset_url }}">
          <img src="{{ 'monte-about-hero-desktop.webp' | asset_url }}" width="1851" height="598" alt="" fetchpriority="high">
        </picture>
      {%- else -%}
      {%- for device in (1..2) -%}
        {%- liquid
          assign device_class = 'desktop'
          assign hero_video = desktop_video
          assign hero_image = desktop_image
          if device == 2
            assign device_class = 'mobile'
            assign hero_video = mobile_video
            assign hero_image = mobile_image
          endif
        -%}
        <div class="monte-collection-hero__{{ device_class }}">
          {%- if hero_video != blank -%}
            {%- render 'media', media: hero_video, autoplay: true, loop: true, show_play_button: true, preload: true, sizes: '100vw' -%}
          {%- elsif hero_image != blank -%}
            {{- hero_image | image_url: width: 3200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,800,1200,1600,2000,2400,3200', sizes: '100vw', alt: '' -}}
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder monte-media-placeholder' | replace: '<svg', '<svg aria-hidden="true" preserveAspectRatio="xMidYMid slice"' -}}
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="monte-collection-hero__overlay" aria-hidden="true"></div>
    <div class="monte-collection-hero__content">
      {% if hero_badge != blank %}<span class="monte-collection-hero__badge" style="background:{{ campaign_content.badge_background.value | default: section.settings.badge_background }};color:{{ campaign_content.badge_color.value | default: section.settings.badge_color }};">{{ hero_badge | escape }}</span>{% endif %}
      {%- if section.settings.show_rating -%}
        <div class="monte-collection-hero__rating">
          {%- render 'monte-social-rating', rating: rating -%}
          {%- if rating_text != blank -%}<p>{{ rating_text | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if hero_heading != blank or hero_subheading != blank -%}
        <div class="monte-collection-hero__copy">
          {%- if hero_heading != blank -%}<h1 class="monte-collection-hero__heading">{{ hero_heading | escape | newline_to_br }}</h1>{%- endif -%}
          {%- if hero_subheading != blank -%}<p class="monte-collection-hero__subheading">{{ hero_subheading | escape | newline_to_br }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</reveal-items>


{%- endunless -%}
