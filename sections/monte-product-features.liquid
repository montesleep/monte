{{ 'monte-product-features.css' | asset_url | stylesheet_tag }}
<script src="{{ 'monte-product-features.js' | asset_url }}" defer></script>
{%- assign carousel_id = 'features-' | append: section.id -%}
<monte-product-features class="monte-features" style="--mf-primary: {{ section.settings.heading_color }}; --mf-secondary: {{ section.settings.body_color }}; --mf-surface: {{ section.settings.surface_color }}; --mf-badge: {{ section.settings.badge_color }}; --mf-badge-text: {{ section.settings.badge_text_color }}; --mf-top: {{ section.settings.padding_top_desktop }}px; --mf-bottom: {{ section.settings.padding_bottom_desktop }}px; --mf-mobile-top: {{ section.settings.padding_top_mobile }}px; --mf-mobile-bottom: {{ section.settings.padding_bottom_mobile }}px;">
  <reveal-items class="monte-features__reveal" margin="0px">
    {%- if section.settings.heading != blank -%}<h2 class="monte-features__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <scroll-carousel id="{{ carousel_id }}" class="monte-features__track" selector=".monte-feature" role="region" aria-label="{{ section.settings.accessibility_label | escape }}" tabindex="0">
        {%- for block in section.blocks -%}
          {%- render 'monte-feature-card', block: block, section: section, index: forloop.index -%}
        {%- endfor -%}
      </scroll-carousel>
      <scroll-progress class="monte-features__progress scrollbar__progress" observes="{{ carousel_id }}" aria-hidden="true" hidden style="--scroll-progress: 0;"></scroll-progress>
    {%- endif -%}
  </reveal-items>
</monte-product-features>

{% schema %}
{
  "name": "Monté Product Features",
  "tag": "section",
  "class": "shopify-section--monte-features",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Małe detale, które\nzmieniają jakość snu"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Carousel accessibility label",
      "default": "Małe detale Monté"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbered badges",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings and progress",
      "default": "#232E71"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Descriptions",
      "default": "#52597E"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Media and progress background",
      "default": "#EEE7E0"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge background",
      "default": "#D9A17D"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#FDFBF9"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Product feature"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Badge text",
          "info": "Leave empty for automatic numbering. Keep custom text short."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video",
          "info": "Replaces the image. Autoplays, muted and looped, without controls."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Replaces the image. Autoplays, muted and looped, without controls. Empty mobile media fields use desktop media."
        },
        {
          "type": "select",
          "id": "design_image",
          "label": "Design image when no media is selected",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "1",
              "label": "Temperature regulation"
            },
            {
              "value": "2",
              "label": "Adjustable fastening"
            },
            {
              "value": "3",
              "label": "Restful sleep"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Monté Product Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Chłodny latem, przyjemny zimą",
            "description": "<p>Naturalna regulacja temperatury każdej nocy.</p>",
            "design_image": "1"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Rzep, który się dopasowuje",
            "description": "<p>Bez ucisku na skronie, nie czepia się o włosy.</p>",
            "design_image": "2"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Budzisz się bardziej wypoczęta",
            "description": "<p>Głęboki sen w pełnej ciemności.</p>",
            "design_image": "3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
